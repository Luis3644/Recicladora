{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Run en tu celular",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run",
        "-d",
        "9DUS497POV4T5P6D"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(Building|Running).*",
          "endsPattern": "^(Built|Application|For help).*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    }
  ]
}
